generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 管理端用户模型 (Admin)
// ============================================
model Admin {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  avatar        String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // 关联
  refreshTokens AdminRefreshToken[]
  roles         AdminRole[]
  agentCreatedBy Agent[] @relation("AgentCreatedBy")
  agentUpdatedBy Agent[] @relation("AgentUpdatedBy")
  llmConfigCreatedBy LlmConfig[] @relation("LlmConfigCreatedBy")
  llmConfigUpdatedBy LlmConfig[] @relation("LlmConfigUpdatedBy")
  wecomConfigCreatedBy WecomConfig[] @relation("WecomConfigCreatedBy")
  wecomConfigUpdatedBy WecomConfig[] @relation("WecomConfigUpdatedBy")

  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("admins")
}

// ============================================
// 小程序用户模型 (User)
// ============================================
model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String? // 可选字段（微信用户不需要）
  passwordHash String

  // 微信相关字段
  openid     String? @unique // 微信用户唯一标识
  unionid    String? @unique // 开放平台标识（可选）
  sessionKey String? // 会话密钥（加密存储）

  phone       String?
  avatar      String?
  nickname    String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // 关联
  refreshTokens UserRefreshToken[]
  identities    UserIdentity[]
  orders        Order[]
  agentSessions AgentSession[]

  @@index([openid])
  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("users")
}

// ============================================
// 角色模型 (仅用于 Admin)
// ============================================
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  level       Int      @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // 关联
  permissions RolePermission[]
  admins      AdminRole[]

  @@index([slug])
  @@index([deletedAt])
  @@map("roles")
}

// ============================================
// 权限模型
// ============================================
model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  // 关联
  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([deletedAt])
  @@map("permissions")
}

// ============================================
// Admin 角色关联
// ============================================
model AdminRole {
  id         String   @id @default(cuid())
  adminId    String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  // 关联
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, roleId])
  @@index([adminId])
  @@index([roleId])
  @@map("admin_roles")
}

// ============================================
// 角色权限关联
// ============================================
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  // 关联
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================
// Admin 刷新令牌
// ============================================
model AdminRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  // 关联
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
  @@map("admin_refresh_tokens")
}

// ============================================
// User 刷新令牌
// ============================================
model UserRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  // 关联
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_refresh_tokens")
}

// ============================================
// LlmConfig 模型（AI 第 1 层：LLM 配置）
// apiKey 经 AES-256-GCM 加密存 apiKeyEnc，明文永不落库/回传/入日志
// ============================================
model LlmConfig {
  id          String   @id @default(cuid())
  name        String // 显示名，如 "DeepSeek 生产"
  configKey   String   @unique // 程序引用键，YML 节点 llm: configKey
  provider    String   @default("openai") // pi provider 键，MVP 仅 openai（兼容 openai-compatible 端点）
  apiUrl      String   @default("https://api.openai.com/v1")
  apiKeyEnc   String // "v1:" + base64(iv | authTag | ciphertext)
  apiKeyMask  String? // 展示掩码，如 "sk-***abcd"
  model       String // 默认模型名
  temperature Float?
  maxTokens   Int?
  timeoutMs   Int      @default(60000)
  maxRetries  Int      @default(1)
  inputPricePer1M  Float? // 元/百万输入 tokens，成本归因（空=回退全局兜底键；仅归因不参与计费）
  outputPricePer1M Float? // 元/百万输出 tokens
  isDefault   Boolean  @default(false) // 全局默认（应用层保证唯一）
  isActive    Boolean  @default(true)
  description String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Admin? @relation("LlmConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("LlmConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  agents Agent[]

  @@map("llm_configs")
}

// ============================================
// AgentRun 模型（AI 第 3 层：执行记录，最小 observability）
// ============================================
model AgentRun {
  id              String   @id @default(cuid())
  agentId         String? // FK → Agent，YML 移除后 run 仍可考
  agent           Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentSlug       String // 冗余常驻，YML 删除后仍可读
  status          String   @default("running") // running | success | failed | truncated
  input           Json
  output          String?
  error           String?
  nodeTrace       Json? // [{nodeId,type,iterations,toolCalls:[{name,args,ok,ms}],durationMs,warnings}]
  usage           Json? // {calls,promptTokens,completionTokens,totalTokens}
  durationMs      Int?
  triggeredById   String? // 无 FK（admin/user 双源）
  triggeredByType String? // "admin" | "user" | "trigger"（定时触发，ADR-009）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentSlug, createdAt])
  @@index([status])
  @@map("agent_runs")
}

// ============================================
// LlmCallLog 模型（AI 第 1 层：LLM 请求级用量流水，ADR-007）
// 与 AgentRun 正交：AgentRun 记一次 agent 执行，本表记一次 LLM 请求
// （loop 节点多轮工具循环 = 一个 run、多次 LLM 请求）。
// 隐私红线：不落 prompt/出参全文；errorMsg 截 200 字。
// ============================================
model LlmCallLog {
  id              String   @id @default(cuid())
  traceId         String // 缺省补 uuid；agent 调用时 = AgentRun.id（一次 run 的多次调用共享）
  sceneKey        String? // = agentSlug（归因维度；无 run 上下文的散调为空）
  callType        String // CHAT | CHAT_STREAM | AGENT_LOOP（Zod 枚举同源；无 Prisma enum 惯例）
  model           String
  llmConfigId     String? // 无 FK（env 兜底配置无行 id）
  status          String // SUCCESS | ERROR | TIMEOUT | ABORTED
  inputTokens     Int?
  outputTokens    Int?
  promptChars     Int?
  completionChars Int?
  latencyMs       Int?
  errorClass      String? // timeout | abort | http_4xx | http_5xx | unknown
  errorMsg        String? // 截 200 字
  temperature     Float?
  maxTokens       Int?
  day             String // UTC+8 统计日桶（趋势聚合单源，与服务器时区解耦）
  props           Json? // 扩展元数据（nodeId/configKey 等）
  createdAt       DateTime @default(now())

  @@index([sceneKey, createdAt])
  @@index([status, createdAt])
  @@index([traceId])
  @@index([day])
  @@map("llm_call_logs")
}

// ============================================
// SystemSetting 模型（平台参数中心，ADR-008）
// key 与环境变量同名；元数据真理源在 infra/shared settings 目录，
// DB 只存值——读取链 DB → env → 派生（SettingsService 内存缓存）
// ============================================
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String? // 空串等价未设置（回退 env）
  group     String // 目录分组键（base/llm/...）
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ============================================
// AgentTrigger 模型（AI 第 3 层：定时触发，ADR-009）
// 泛化形态：动作 = run(agentSlug)。YML triggers.cron 为真理源时 source='yml'
// （loader 启动同步，enabled 为 DB 权威）；管理端手建 source='manual'。
// nextRunAt 为 CAS 调度水位（dispatcher updateMany compare-and-swap 抢占）。
// ============================================
model AgentTrigger {
  id          String    @id @default(cuid())
  name        String
  agentSlug   String // 目标 agent（runtime.run(slug)）
  schedule    String // HOURLY | DAILY_HH（受限白名单形态，Zod 同源）
  input       Json? // 运行输入（缺省 {}）
  source      String    @default("manual") // yml | manual
  enabled     Boolean   @default(true) // DB 权威（YML 同步不覆盖）
  lastRunAt   DateTime?
  nextRunAt   DateTime? // CAS 水位：抢占成功即推进（崩溃不重放）
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([agentSlug, source])
  @@map("agent_triggers")
}

// ============================================
// AgentSession / AgentMessage 模型（AI 第 3 层：用户端多轮会话，ADR-006）
// 会话作用域仅用户端：归属恒为 User（admin 调用会话端点 403）
// ============================================
model AgentSession {
  id            String   @id @default(cuid())
  agentSlug     String // 冗余常驻：会话绑定单一 agent，不跨 agent 复用
  title         String? // 首条用户消息截断生成
  lastMessageAt DateTime @default(now()) // 会话列表排序键
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([userId, lastMessageAt])
  @@map("agent_sessions")
}

model AgentMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant
  content   String
  runId     String? // → AgentRun 审计关联（无 FK，同 AgentRun.triggeredById 风格）
  createdAt DateTime @default(now())

  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("agent_messages")
}

// ============================================
// Agent 模型（AI 第 3 层：部署期绑定记录）
// 编排定义真理源在 YML（apps/api/src/ai/definitions/agents/），
// DB 行只保留部署期关注点，由 loader 按 slug upsert 同步展示字段
// ============================================
model Agent {
  id          String   @id @default(cuid())
  slug        String   @unique // = YML agent.name = REST 触发路径段
  name        String // loader 从 YML 同步的展示缓存
  description String?
  icon        String?
  llmConfigId String? // Agent 级默认模型配置（节点无 llm: 时回退，D3）
  llmConfig   LlmConfig? @relation(fields: [llmConfigId], references: [id], onDelete: SetNull)
  tools       Json? // Agent 级默认工具清单 string[]（loop 节点无 tools: 时回退）
  isActive    Boolean  @default(true) // kill switch（DB 权威，loader 不覆盖）
  sort        Int      @default(0) // DB 权威
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Admin? @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("AgentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  runs AgentRun[]

  @@index([isActive])
  @@map("agents")
}

// ============================================
// 企业微信应用配置 (WecomConfig)
// ============================================
model WecomConfig {
  id             String   @id @default(cuid())
  name           String
  corpId         String
  agentId        Int
  secret         String
  token          String
  encodingAESKey String
  description    String?
  isActive       Boolean  @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联
  messages  WecomMessage[]
  events    WecomEvent[]
  createdBy Admin? @relation("WecomConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("WecomConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([corpId, agentId])
  @@index([corpId])
  @@index([isActive])
  @@map("wecom_configs")
}

// ============================================
// 企业微信消息记录 (WecomMessage)
// ============================================
model WecomMessage {
  id        String   @id @default(cuid())
  configId  String
  direction String
  msgType   String
  fromUser  String?
  toUser    String?
  content   String?
  rawXml    String?
  createdAt DateTime @default(now())

  config WecomConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([createdAt])
  @@map("wecom_messages")
}

// ============================================
// 企业微信事件记录 (WecomEvent)
// ============================================
model WecomEvent {
  id        String   @id @default(cuid())
  configId  String
  eventType String
  eventKey  String?
  fromUser  String?
  content   String?
  rawXml    String?
  createdAt DateTime @default(now())

  config WecomConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([eventType])
  @@index([createdAt])
  @@map("wecom_events")
}

// ============================================
// P0 票务核心模型
// ============================================

model UserIdentity {
  id            String   @id @default(cuid())
  userId        String
  appId         String
  openid        String
  unionid       String?
  sessionKeyEnc String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, openid])
  @@index([userId])
  @@index([unionid])
  @@map("user_identities")
}

model Line {
  id            String    @id @default(cuid())
  legacyId      String?   @unique
  name          String
  startCity     String
  endCity       String
  publishStatus String    @default("DRAFT") // DRAFT | PUBLISHED
  sort          Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  stations  LineStation[]
  templates ScheduleTemplate[]
  trips     Trip[]
  orders    Order[]

  @@index([publishStatus])
  @@index([deletedAt])
  @@map("lines")
}

model Station {
  id        String    @id @default(cuid())
  legacyId  String?   @unique
  name      String
  address   String
  lng       Float?
  lat       Float?
  sort      Int       @default(0)
  status    String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lineStations LineStation[]

  @@index([deletedAt])
  @@map("stations")
}

model LineStation {
  id        String   @id @default(cuid())
  lineId    String
  stationId String
  type      String // BOARD | ALIGHT
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  line    Line    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([lineId, stationId, type])
  @@index([lineId])
  @@index([stationId])
  @@map("line_stations")
}

model ScheduleTemplate {
  id            String    @id @default(cuid())
  legacyId      String?   @unique
  lineId        String
  name          String
  departureTime String // HH:mm
  priceCents    Int
  totalSeats    Int
  weekdays      String    @default("1,2,3,4,5,6,7") // 1=周一 ... 7=周日
  status        String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  line  Line   @relation(fields: [lineId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@index([lineId])
  @@index([deletedAt])
  @@map("schedule_templates")
}

model Trip {
  id            String   @id @default(cuid())
  templateId    String?
  lineId        String
  serviceDate   String // YYYY-MM-DD
  departureTime String // HH:mm
  priceCents    Int
  totalSeats    Int
  soldSeats     Int      @default(0)
  status        String   @default("ON_SALE") // ON_SALE | STOPPED | DEPARTED | COMPLETED | CANCELLED
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  template ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  line     Line               @relation(fields: [lineId], references: [id], onDelete: Restrict)
  orders   Order[]
  checkIns CheckIn[]
  operations   TripOperation[]

  @@unique([lineId, serviceDate, departureTime])
  @@index([lineId, serviceDate, status])
  @@index([serviceDate])
  @@map("trips")
}

model Order {
  id                 String    @id @default(cuid())
  orderNo            String    @unique
  idempotencyKey     String?   @unique
  userId             String
  lineId             String
  tripId             String
  boardingStationId  String?
  alightingStationId String?
  contactName        String
  contactPhone       String
  ticketCount        Int
  totalAmountCents   Int
  payStatus          String    @default("UNPAID") // UNPAID | PENDING | PAID | REFUNDING | PARTIAL_REFUND | REFUNDED | CLOSED
  orderStatus        String    @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | COMPLETED | REFUNDING | PARTIALLY_REFUNDED | REFUNDED | CLOSED
  expiresAt          DateTime?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  line     Line     @relation(fields: [lineId], references: [id], onDelete: Restrict)
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tickets  Ticket[]
  payment  Payment?
  refunds  Refund[]

  @@index([userId, createdAt])
  @@index([tripId])
  @@index([contactPhone])
  @@index([orderStatus])
  @@map("orders")
}

model Ticket {
  id            String    @id @default(cuid())
  ticketNo      String    @unique
  orderId       String
  passengerName String
  phone         String?
  priceCents    Int
  status        String    @default("UNUSED") // UNUSED | CHECKED_IN | REFUNDING | REFUNDED | CANCELLED
  checkCode     String    @unique
  checkedAt     DateTime?
  checkedBy     String?
  departureNotifiedAt DateTime? // 发车提醒订阅消息已发时间（去重）
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  checkIn CheckIn?

  @@index([orderId])
  @@index([status])
  @@map("tickets")
}

model Payment {
  id            String    @id @default(cuid())
  paymentNo     String    @unique
  orderId       String    @unique
  outTradeNo    String    @unique
  transactionId String?   @unique
  amountCents   Int
  status        String    @default("PENDING") // PENDING | PAID | FAILED | CLOSED
  rawNotify     Json?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model Refund {
  id              String    @id @default(cuid())
  refundNo        String    @unique // 退款单号，即微信 out_refund_no（重试幂等键）
  orderId         String
  ticketIds       Json // 退款票 ID 数组
  ticketCount     Int
  amountCents     Int // 实退金额（分）= 票价合计 - feeCents
  feeCents        Int       @default(0) // 手续费（分）
  reason          String?
  status          String    @default("PROCESSING") // PENDING | PROCESSING | SUCCESS | FAILED
  gatewayRefundNo String? // 微信 refund_id
  operatorId      String? // 管理端操作人（admins.id）；乘客自助为空
  operatorType    String    @default("USER") // USER | ADMIN | SYSTEM（系统自动退款）
  failReason      String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

model Checker {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String
  name         String
  openid       String?  @unique
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  checkIns       CheckIn[]
  tripOperations TripOperation[]

  @@map("checkers")
}

model CheckIn {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  tripId    String
  checkerId String
  method    String   @default("QR") // QR | MANUAL
  checkedAt DateTime @default(now())

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Restrict)
  checker Checker @relation(fields: [checkerId], references: [id], onDelete: Restrict)

  @@index([tripId, checkedAt])
  @@index([checkerId])
  @@map("check_ins")
}

/// 班次操作日志：核销员端调整余票/上下线的审计留痕（重建方案 §9.4 停班类危险操作必留痕）
model TripOperation {
  id        String   @id @default(cuid())
  tripId    String
  checkerId String?
  action    String // ADJUST_SEATS | SET_STATUS
  before    Json? // 操作前快照（totalSeats/soldSeats/status）
  after     Json? // 操作后快照
  createdAt DateTime @default(now())

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  checker Checker? @relation(fields: [checkerId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@map("trip_operations")
}
